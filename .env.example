# Redis connection (for session/credential storage)
REDIS_HOST=192.168.50.3
REDIS_PORT=6379
REDIS_PASS=foobared3121

# UI login password — users enter this to access the web interface
WHATSAPP_UI_PASSWORD=admin

# Session signing secret — used to sign the HttpOnly session cookie via HMAC-SHA256.
# This MUST be a strong, independent secret (not the same as WHATSAPP_UI_PASSWORD).
# If not set, the UI password is used to derive the signing secret.
WHATSAPP_UI_SESSION_SECRET=

# Session cookie TTL in milliseconds (default: 30 days)
WHATSAPP_UI_TOKEN_TTL_MS=2592000000

# Dedicated key for the external POST /send integration.
# Send it in the X-API-Key header. Leave empty to disable the endpoint.
WHATSAPP_EXTERNAL_API_KEY=

# IP blocking after too many failed login attempts (default: 10)
MAX_FAILED_LOGINS=10

# Duration in milliseconds to block an IP after max failed logins (default: 30 minutes)
LOGIN_BLOCK_DURATION_MS=1800000

# Persist all UI message history in Redis. Set a positive number to cap messages per chat.
UI_STORED_MESSAGE_LIMIT=0

# Cache group metadata fetches in Redis for 10 minutes.
UI_GROUP_METADATA_CACHE_MS=600000

# Target URL for the API proxy (if applicable)
API_TARGET=http://localhost:3000
